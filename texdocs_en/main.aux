\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Hardware gain ladder and certified $\gamma $ ladder (matched DC stiffness $k=ab$; $\gamma ^{*}=1/(a+b)$ by Theorem~3(c$'$), with certificate point $(\kappa ,\gamma _a)=(\gamma ^{*},\sqrt  {\gamma ^{*}})$). The bracketed $(\gamma _O,\gamma _T)$ of C3 are that law's internal $H_\infty $ parameters ($k_O=\sqrt  2/\gamma _O$, $k_T=\sqrt  2/\gamma _T$, $k_{\mathrm  {servo}}=20$), unrelated to the certified gain $\gamma ^{*}$. $^\dagger $At the discretization boundary ($b\,\Delta t=0.15$), not run on hardware. $^\ddagger $Reference configuration for $5\,\mathrm  {ms}$ control; violates the discretization constraint at $100\,\mathrm  {Hz}$.}}{11}{}\protected@file@percent }
\newlabel{tab:hw-gains}{{1}{11}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Results and analysis}{11}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Gain ladder per law (tether $30\,\mathrm  {N\,m/rad}$, the tiers of $k\in \{8,16,24,36\}$ available to each law, single runs of the $10\,\mathrm  {s}$ nominal trajectory, aligned on traj\_t): the orientation and twist transients decrease monotonically with $k$ and the position error mildly so, in the direction of tightening $\gamma ^{*}$ (Theorem~3(c$'$)).}}{12}{}\protected@file@percent }
\newlabel{fig:hw-ladder}{{1}{12}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Conclusion}{12}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Tether sweep with four laws ($k{=}36$): left, $K_{\mathrm  {tr}}{=}12\,\mathrm  {N\,m/rad}$ (friction-balance dominated, steady residual $\approx 30\,\mathrm  {mm}$); right, $K_{\mathrm  {tr}}{=}60\,\mathrm  {N\,m/rad}$ (millimeter level, steady $\approx 5.5\,\mathrm  {mm}$). The residual varies nearly inversely with the tether stiffness while the four laws remain on top of each other.}}{13}{}\protected@file@percent }
\newlabel{fig:hw-laws-tether}{{2}{13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Four laws at equal budget ($k{=}36$, tether $30\,\mathrm  {N\,m/rad}$, single runs, $10\,\mathrm  {s}$ nominal trajectory): (a) position error; (b) orientation error; (c) twist error $\|e_\xi \|$; (d) pose error $\|e_z\|$. The four curves coincide in all channels, a hardware confirmation of the equal-information-set equivalence; the contribution of C1 lies in the certificate (Table~\ref {tab:hw-gains}), not in accuracy.}}{13}{}\protected@file@percent }
\newlabel{fig:hw-laws-tether30}{{3}{13}{}{}{}}
