\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces 实机增益阶梯与认证 $\gamma $ 阶梯（同 DC 刚度 $k=ab$ 配平；$\gamma ^{*}=1/(a+b)$ 按定理~3(c$'$) 取最优证书，证书点 $(\kappa ,\gamma _a)=(\gamma ^{*},\sqrt  {\gamma ^{*}})$）。C3 括号内 $(\gamma _O,\gamma _T)$ 为其律内 H∞ 参数（$k_O=\sqrt  2/\gamma _O$、$k_T=\sqrt  2/\gamma _T$、$k_{\mathrm  {servo}}=20$），与本文认证增益 $\gamma ^{*}$ 无关。}}{9}{table.1}\protected@file@percent }
\newlabel{tab:hw-gains}{{1}{9}{实机增益阶梯与认证 $\gamma $ 阶梯（同 DC 刚度 $k=ab$ 配平；$\gamma ^{*}=1/(a+b)$ 按定理~3(c$'$) 取最优证书，证书点 $(\kappa ,\gamma _a)=(\gamma ^{*},\sqrt {\gamma ^{*}})$）。C3 括号内 $(\gamma _O,\gamma _T)$ 为其律内 H∞ 参数（$k_O=\sqrt 2/\gamma _O$、$k_T=\sqrt 2/\gamma _T$、$k_{\mathrm {servo}}=20$），与本文认证增益 $\gamma ^{*}$ 无关。}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}结果与分析}{9}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 各律增益阶梯（拴定 $30\,\mathrm  {N\,m/rad}$，$k\in \{8,16,24,36\}$ 中各律可用档，$10\,\mathrm  {s}$ 标准轨迹单次运行，traj\_t 对齐）：姿态与 twist 瞬态误差随 $k$ 单调下降，位置误差弱下降，与 $\gamma ^{*}$ 收紧（定理~3(c$'$)）的方向一致。}}{10}{figure.1}\protected@file@percent }
\newlabel{fig:hw-ladder}{{1}{10}{各律增益阶梯（拴定 $30\,\mathrm {N\,m/rad}$，$k\in \{8,16,24,36\}$ 中各律可用档，$10\,\mathrm {s}$ 标准轨迹单次运行，traj\_t 对齐）：姿态与 twist 瞬态误差随 $k$ 单调下降，位置误差弱下降，与 $\gamma ^{*}$ 收紧（定理~3(c$'$)）的方向一致。}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 拴定刚度扫描下的四律对比（$k{=}36$）：左为 $K_{\mathrm  {tr}}{=}12\,\mathrm  {N\,m/rad}$（摩擦平衡主导，终态残差 $\approx 30\,\mathrm  {mm}$）；右为 $K_{\mathrm  {tr}}{=}60\,\mathrm  {N\,m/rad}$（毫米级，终态 $\approx 5.5\,\mathrm  {mm}$）。终态残差随拴定刚度下降而增大，且四律保持重合。}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:hw-laws-tether}{{2}{11}{拴定刚度扫描下的四律对比（$k{=}36$）：左为 $K_{\mathrm {tr}}{=}12\,\mathrm {N\,m/rad}$（摩擦平衡主导，终态残差 $\approx 30\,\mathrm {mm}$）；右为 $K_{\mathrm {tr}}{=}60\,\mathrm {N\,m/rad}$（毫米级，终态 $\approx 5.5\,\mathrm {mm}$）。终态残差随拴定刚度下降而增大，且四律保持重合。}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 等控制资源条件下的四律对比（$k{=}36$，单次运行，$10\,\mathrm  {s}$ 标准轨迹）：左为 $K_{\mathrm  {tr}}{=}2\,\mathrm  {N\,m/rad}$（拴定近乎退出的纯度极限，准静态残差由摩擦死区决定、约 $32$--$40\,\mathrm  {mm}$）；右为 $K_{\mathrm  {tr}}{=}30\,\mathrm  {N\,m/rad}$（终态 $\approx 17\,\mathrm  {mm}$）。拴定刚度跨越一个数量级，所示记录中的四条曲线接近；C1 的收益在证书（表~\ref {tab:hw-gains}）而非精度。}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:hw-laws-tether30}{{3}{11}{等控制资源条件下的四律对比（$k{=}36$，单次运行，$10\,\mathrm {s}$ 标准轨迹）：左为 $K_{\mathrm {tr}}{=}2\,\mathrm {N\,m/rad}$（拴定近乎退出的纯度极限，准静态残差由摩擦死区决定、约 $32$--$40\,\mathrm {mm}$）；右为 $K_{\mathrm {tr}}{=}30\,\mathrm {N\,m/rad}$（终态 $\approx 17\,\mathrm {mm}$）。拴定刚度跨越一个数量级，所示记录中的四条曲线接近；C1 的收益在证书（表~\ref {tab:hw-gains}）而非精度。}{figure.3}{}}
