\newlabel{fig:sec6-gain-tiers}{{2}{10}{C1 两种增益档的稳态残差对比（带载标准工况）：(a)(b) 位置/姿态误差时序；(c)(d) 圆周稳态窗口内的 RMS。刚度提高 $2.25$ 倍使稳态残差降低约 $2.21$ 倍，符合标度律 \eqref {eq:5.9} 的线性预测。}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 静态刚度标度律 \eqref  {eq:5.9} 的扰动反演一致性：(a) 三个独立增益档反演同一物理扰动 $d_{\mathrm  {ex}}$ 的幅值；(b) 相对 tuned--fast 均值的偏差——tuned/fast 一致至 $\pm 1\%$ 以内，未补偿 1/4 旋转折减的 base 档偏离 $-35.5\%$/$-39.0\%$，标度律失效。}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:sec6-v1-inversion}{{3}{10}{静态刚度标度律 \eqref {eq:5.9} 的扰动反演一致性：(a) 三个独立增益档反演同一物理扰动 $d_{\mathrm {ex}}$ 的幅值；(b) 相对 tuned--fast 均值的偏差——tuned/fast 一致至 $\pm 1\%$ 以内，未补偿 1/4 旋转折减的 base 档偏离 $-35.5\%$/$-39.0\%$，标度律失效。}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 极限工况下的控制器分化：(a) 标准/高速/噪声三工况的稳态 twist 误差 RMS；(b) 相对 C1 的偏差——C2 与 C1 数值等价（$\le 0.05\%$），C3 系统性劣化（噪声下 $+2.2\%$、高速下 $+2.0\%$），与桥接差分和前馈结构缺陷的机制一致。}}{11}{figure.4}\protected@file@percent }
